{
  "name": "node-ci-cd-example",
  "version": "1.0.0",
  "description": "Node.js todo microservice with a reusable GitHub Actions CI/CD pipeline and blue-green deploys to Azure Web Apps",
  "main": "src/server.js",
  "scripts": {
